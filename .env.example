NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://user:password@cluster.example/stock-control
SESSION_SECRET=replace-with-at-least-32-random-characters
SQLITE_PATH=./data/outbox.sqlite
LOG_LEVEL=info
LOG_PATH=./logs
BACKUP_PATH=./backups
HOST_BACKUP_PATH=./backups
MONGODB_CONNECT_ON_START=true
COOKIE_SECURE=false
SESSION_HOURS=8
SYNC_INTERVAL_MS=5000
SYNC_BATCH_SIZE=25
BUSINESS_TIME_ZONE=America/Montevideo
OUTBOX_SYNCED_RETENTION_DAYS=90
SWAGGER_ENABLED=true
