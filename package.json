{
  "name": "stock-control",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:e2e": "concurrently -k -s first -n api,ui \"npm run start:e2e -w backend\" \"npm run dev -w frontend\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:check": "node scripts/check-version.js",
    "release:patch": "npm version patch --workspaces --include-workspace-root --no-git-tag-version",
    "release:minor": "npm version minor --workspaces --include-workspace-root --no-git-tag-version",
    "release:major": "npm version major --workspaces --include-workspace-root --no-git-tag-version",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:coverage": "npm run test:coverage -w backend && npm run test:coverage -w frontend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "playwright test",
    "build": "npm run build -w frontend && npm run build -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
